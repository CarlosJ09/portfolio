---
import "@fontsource-variable/source-serif-4/opsz.css";
import "@fontsource-variable/source-serif-4/opsz-italic.css";
import "@fontsource-variable/jetbrains-mono/wght.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description: string;
}

const { description, title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />

    <!-- Apply the saved theme before first paint, and again after every view-transition swap. -->
    <script is:inline>
      (() => {
        const apply = () => {
          let pref = "system";
          try {
            pref = localStorage.getItem("theme") ?? "system";
          } catch {}
          const dark =
            pref === "dark" ||
            (pref === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
          document.documentElement.dataset.themePref = pref;
        };
        window.__applyTheme = apply;
        apply();
        document.addEventListener("astro:after-swap", apply);
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", apply);
      })();
    </script>
  </head>

  <body class="bg-paper text-ink font-serif antialiased">
    <Header />
    <slot />
    <Footer />

    <style is:global>
      :root {
        color-scheme: light;
        --paper: 250 248 243; /* #faf8f3 */
        --ink: 28 27 25; /* #1c1b19 */
        --muted: 92 89 84; /* #5c5954 */
        --rule: 217 212 202; /* #d9d4ca */
        --accent: 30 74 138; /* #1e4a8a, ink blue */
      }

      :root.dark {
        color-scheme: dark;
        --paper: 26 25 23; /* #1a1917 */
        --ink: 236 232 224; /* #ece8e0 */
        --muted: 166 161 152; /* #a6a198 */
        --rule: 60 58 53; /* #3c3a35 */
        --accent: 143 180 232; /* #8fb4e8 */
      }

      html {
        scroll-behavior: smooth;
        overflow-x: clip;
        font-optical-sizing: auto;
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        font-size: 1.0625rem;
        line-height: 1.65;
      }

      ::selection {
        background: rgb(var(--accent) / 0.2);
      }

      :focus-visible {
        outline: 2px solid rgb(var(--accent));
        outline-offset: 3px;
        border-radius: 2px;
      }

      /* Text links: underlined in the accent, readable at rest. */
      .link {
        color: rgb(var(--accent));
        text-decoration-line: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
        text-decoration-color: rgb(var(--accent) / 0.4);
        transition: text-decoration-color 150ms;
      }
      .link:hover {
        text-decoration-color: rgb(var(--accent));
      }

      code {
        font-family: theme("fontFamily.mono");
        font-size: 0.85em;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </body>
</html>
