---
import "@fontsource-variable/source-serif-4/opsz.css";
import "@fontsource-variable/source-serif-4/opsz-italic.css";
import "@fontsource-variable/jetbrains-mono/wght.css";

import serifFont from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  /** Path under /public, e.g. "/og.png". 1200×630 PNG. */
  ogImage?: string;
  ogType?: "website" | "article";
}

const { description, title, ogImage = "/og.png", ogType = "website" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1917" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Carlos Jiménez" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Carlos Jiménez, full-stack engineer" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="generator" content={Astro.generator} />
    <ViewTransitions />

    <!-- Apply the saved theme before first paint, and again after every view-transition swap. -->
    <script is:inline>
      (() => {
        const apply = () => {
          let pref = "system";
          try {
            pref = localStorage.getItem("theme") ?? "system";
          } catch {}
          const dark =
            pref === "dark" ||
            (pref === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
          document.documentElement.dataset.themePref = pref;
        };
        window.__applyTheme = apply;
        apply();
        document.addEventListener("astro:after-swap", apply);
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", apply);
      })();
    </script>
  </head>

  <body class="bg-paper text-ink font-serif antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:text-paper"
      >Skip to content</a
    >
    <Header />
    <slot />
    <Footer />

    <style is:global>
      :root {
        color-scheme: light;
        --paper: 250 248 243; /* #faf8f3 */
        --ink: 28 27 25; /* #1c1b19 */
        --muted: 92 89 84; /* #5c5954 */
        --rule: 217 212 202; /* #d9d4ca */
        --accent: 30 74 138; /* #1e4a8a, ink blue */
      }

      :root.dark {
        color-scheme: dark;
        --paper: 26 25 23; /* #1a1917 */
        --ink: 236 232 224; /* #ece8e0 */
        --muted: 166 161 152; /* #a6a198 */
        --rule: 60 58 53; /* #3c3a35 */
        --accent: 143 180 232; /* #8fb4e8 */
      }

      html {
        scroll-behavior: smooth;
        overflow-x: clip;
        font-optical-sizing: auto;
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        font-size: 1.0625rem;
        line-height: 1.65;
      }

      ::selection {
        background: rgb(var(--accent) / 0.2);
      }

      :focus-visible {
        outline: 2px solid rgb(var(--accent));
        outline-offset: 3px;
        border-radius: 2px;
      }

      /* Text links: underlined in the accent, readable at rest. */
      .link {
        color: rgb(var(--accent));
        text-decoration-line: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
        text-decoration-color: rgb(var(--accent) / 0.4);
        transition: text-decoration-color 150ms;
      }
      .link:hover {
        text-decoration-color: rgb(var(--accent));
      }

      code {
        font-family: theme("fontFamily.mono");
        font-size: 0.85em;
        white-space: nowrap;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </body>
</html>
