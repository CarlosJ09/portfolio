---
const THEMES = ["light", "dark", "system"] as const;
---

<div role="group" aria-label="Color theme" class="flex items-baseline gap-x-2">
  {
    THEMES.map((theme, i) => (
      <>
        {i > 0 && (
          <span aria-hidden="true" class="text-rule">
            /
          </span>
        )}
        <button
          type="button"
          data-theme-option={theme}
          aria-pressed="false"
          class="text-muted hover:text-ink aria-pressed:text-ink aria-pressed:underline underline-offset-4 decoration-accent"
        >
          {theme}
        </button>
      </>
    ))
  }
</div>

<script>
  // Bundled module: runs once. Re-binds after each view-transition swap via astro:page-load.
  type Win = Window & { __applyTheme?: () => void };

  const sync = () => {
    const pref = document.documentElement.dataset.themePref ?? "system";
    document.querySelectorAll<HTMLButtonElement>("[data-theme-option]").forEach((btn) => {
      btn.setAttribute("aria-pressed", String(btn.dataset.themeOption === pref));
    });
  };

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-option]").forEach((btn) => {
      btn.addEventListener("click", () => {
        try {
          localStorage.setItem("theme", btn.dataset.themeOption ?? "system");
        } catch {}
        (window as Win).__applyTheme?.();
        sync();
      });
    });
    sync();
  });
</script>
