---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { title: "Experience", url: "/#experience" },
  { title: "Projects", url: "/#projects" },
  { title: "Skills", url: "/#skills" },
  { title: "Education", url: "/#education" },
  { title: "About", url: "/#about-me" },
];
---

<header
  class="mx-auto w-full max-w-page px-5 sm:px-8 pt-8 pb-4 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3 font-mono text-xs"
>
  <a href="/" class="uppercase tracking-[0.18em] text-ink hover:text-accent">Carlos Jiménez</a>
  <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
    <nav aria-label="Sections" class="flex flex-wrap gap-x-4 gap-y-1">
      {
        navItems.map((link) => (
          <a class="text-muted hover:text-accent" href={link.url}>
            {link.title}
          </a>
        ))
      }
    </nav>
    <ThemeToggle />
  </div>
</header>
