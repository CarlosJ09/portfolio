---
const programmingLangs = [
  { src: "languages/typescript.png", alt: "TypeScript" },
  { src: "languages/react.png", alt: "React" },
  { src: "languages/python.png", alt: "Python" },
  { src: "languages/nodejs.png", alt: "Node.js" },
];
---

<article
  class="flex flex-col items-center justify-center gap-8 text-gray-700 dark:text-gray-300 md:flex-row"
>
  <div
    class="[&>p]:mb-4 [&>p>strong]:text-emerald-500 dark:[&>p>strong]:text-emerald-100 [&>p>strong]:font-normal [&>p>strong]:font-mono text-pretty"
  >
    <p>
      My name is Carlos Jiménez. I started getting interested in programming when I was young, at 15
      years old. Currently, I am <strong>working as a Software Developer</strong>.
    </p>

    <p>
      I have a great passion for <strong>technology and innovation</strong>. I enjoy working in
      productive teams where I can test my knowledge and learn new stuff.
    </p>

    <p>
      I am currently a student of Systems Engineering at the Instituto Tecnológico de Santo Domingo.
      I am passionate about exploring new technologies and finding creative solutions to complex
      problems.
    </p>
  </div>

  <div class="grid grid-cols-2 gap-8 w-40 md:w-96 md:mb-10">
    {
      programmingLangs.map((lang) => (
        <img
          class="transition-all duration-300 hover:scale-110 hover:rotate-6 shadow-md"
          src={lang.src}
          alt={lang.alt}
        />
      ))
    }
  </div>
</article>
