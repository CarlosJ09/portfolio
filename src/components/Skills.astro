---
// From CLAUDE.md §6. Carlos approved it as-is on 2026-11-09; to be refined later.
const GROUPS = [
  {
    title: "Daily",
    skills: ["TypeScript", "Vue 3 / Nuxt", "Node.js / NestJS", "PostgreSQL", "AWS"],
  },
  {
    title: "AI / LLM",
    skills: ["Amazon Bedrock", "RAG", "LLM evaluation", "Local inference (Ollama)"],
  },
  {
    title: "Also shipped with",
    skills: ["React / Next.js", "Python (FastAPI, Django)", "Java / Spring Boot"],
  },
  {
    title: "Languages",
    skills: ["Spanish (native)", "English (professional)"],
  },
];
---

<div class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
  {
    GROUPS.map(({ title, skills }) => (
      <section class="border-t-2 border-ink pt-4">
        <h3 class="text-lg font-semibold">{title}</h3>
        <ul class="mt-3 space-y-1.5">
          {skills.map((skill) => (
            <li class="flex items-baseline gap-3">
              <span aria-hidden="true" class="size-1.5 shrink-0 translate-y-[-0.15em] rounded-full bg-accent" />
              {skill}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
