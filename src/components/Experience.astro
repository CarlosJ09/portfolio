---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCIE = [
  {
    date: "August 2025 - Present",
    title: "Frontend Developer",
    company: "Thryv",
    description:
      "Developing and maintaining modern, scalable web interfaces for Thryv's business management SaaS platform using React and TypeScript. Collaborating cross-functionally with design and backend teams to ship high-quality features that serve thousands of small businesses.",
  },
  {
    date: "February 2025 - August 2025",
    title: "Full Stack Developer",
    company: "Dominicana Compañia de Seguros",
    description:
      "Developed and maintained robust and scalable backend services using Java with Spring Boot, ensuring high performance and stability in production environments. Developed responsive and dynamic user interfaces using React, ensuring smooth and intuitive user experiences across devices.",
  },
  {
    date: "October 2023 - February 2025",
    title: "Frontend Developer",
    company: "Dominicana Compañia de Seguros",
    description:
      "Created responsive UI components for a client-facing insurance portal using React.js and Redux, enhancing user engagement by 30% and improving customer satisfaction scores through seamless navigation and improved accessibility. Implementing testing frameworks such as Vitest and Jest. Adapting web applications for mobile platforms using React Native and Expo.",
  },
  {
    date: "October 2022 - October 2023",
    title: "Software Developer",
    company: "BotPro S.R.L",
    description:
      "Designed and developed chatbot automation solutions using Node.js. Built scalable backend services with Express and Prisma. Created intuitive, responsive UI components using React.js and TypeScript. Managed database operations with MySQL and MongoDB.",
  },
];
---

<ol class="relative mt-16">
  {
    EXPERIENCIE.map((experiencie) => (
      <li class="">
        <ExperienceItem {...experiencie} />
      </li>
    ))
  }
</ol>
