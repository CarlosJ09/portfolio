---
import ExperienceItem from "./ExperienceItem.astro";

// Confidentiality: the only client/product names allowed are Thryv, Dominicana Compañía de
// Seguros, BotPro S.R.L, and SIGEF / Ministerio de Hacienda y Economía. Describe internal Thryv
// products generically. SIGEF: naming the IDB (BID) as funder is approved by Carlos; never mention
// contract value or any person's name.

const EXPERIENCE = [
  {
    date: "Aug 2025 – Present",
    location: "Dallas, Texas, USA · Remote",
    title: "Full-Stack Engineer · AI & Cloud",
    company: "Thryv",
    summary:
      "Small-business SaaS. I work across Vue 3 and React frontends, the services behind them, and AWS. My day-to-day work is in English.",
    highlights: [
      "With my team, built an AI-powered insights feature end to end on Amazon Bedrock. It gives partners recommendations based on their customer data. I worked on the new NestJS/TypeScript microservice, its AWS infrastructure, and the Vue 3 + Pinia frontend.",
      "Work on a lead-generation product made of a frontend, a BFF, an alerts service, and an analytics service with a semantic layer (Cube) over Snowflake and BigQuery.",
      "When we extracted an app from the monolith into its own project, I led the decision to stay on Vue instead of migrating to React, and reused the existing Auth0 tenant by adding a new application instead of setting up auth from scratch.",
      "Onboard and mentor new engineers on the project: architecture, business domain, how we work, pairing, and code review.",
    ],
  },
  {
    date: "Nov 2025 – Nov 2026",
    location: "Santo Domingo, Dominican Republic · Remote",
    title: "IDB Consultant · Frontend Developer (Contract)",
    company: "SIGEF · Ministerio de Hacienda y Economía",
    summary:
      "Frontend work on the Dominican government's national financial management system, within a financial-transparency program funded by the Inter-American Development Bank (IDB). Nuxt 3, Vue 3, TypeScript, PrimeVue, Keycloak.",
    highlights: [
      "Wrote the pre-refactoring analysis of the frontend service layer: 27 service files, ~222 uses of <code>any</code>, zero test files.",
      "Designed and rolled out a shared composable, <code>useSigefResource</code>, to replace the per-module web-service classes. It's backward compatible, so modules still on the old classes keep working.",
      "Consolidated unused backend classes under a single service, with sign-off from the product owners and architects.",
      "Stabilized modules after a major branch integration: restored pre-integration behavior across the classifiers module, and took on a module that was fully non-functional.",
      "Now on the team that maintains the system in production: tracking down bugs and shipping the fixes.",
    ],
  },
  {
    date: "Oct 2023 – Aug 2025",
    location: "Santo Domingo, Dominican Republic · On-site",
    title: "Frontend → Full-Stack Developer",
    company: "Dominicana Compañía de Seguros",
    highlights: [
      'Built the company\'s main public website from scratch: <a class="link" href="https://dominicanadeseguros.com/site" target="_blank" rel="noopener noreferrer">dominicanadeseguros.com</a>. I chose the framework and stack (Next.js, Tailwind), set up the site\'s structure, wrote part of the content, and was responsible for performance and accessibility.',
      "Built UI for the client-facing insurance portal in React and Redux, improving user engagement by 30%, and wrote tests with Vitest and Jest.",
      "Adapted web applications for mobile with React Native and Expo.",
      "Moved to full-stack in February 2025, building Java/Spring Boot backend services alongside the React UI.",
    ],
  },
  {
    date: "Oct 2022 – Oct 2023",
    location: "Santo Domingo, Dominican Republic · Hybrid",
    title: "Software Developer",
    company: "BotPro S.R.L",
    highlights: [
      "Built a RAG chatbot workflow in Python with FastAPI, LangChain, Pinecone, and the OpenAI API.",
      "Built chatbot automation in Node.js, with Express + Prisma backends, React/TypeScript frontends, and MySQL and MongoDB.",
    ],
  },
];
---

<ol class="space-y-14">
  {
    EXPERIENCE.map((item) => (
      <li>
        <ExperienceItem {...item} />
      </li>
    ))
  }
</ol>
