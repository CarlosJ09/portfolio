---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCIE = [
  {
    date: "October 2023 - Present...",
    title: "Frontend Developer",
    company: "Dominicana Compañia de Seguros",
    description:
      "Developing and maintaining responsive UI components using React and Vue.js. Ensuring seamless API integrations. Implementing testing frameworks such as Vitest and Jest. Adapting web applications for mobile platforms using React Native and Expo.",
  },
  {
    date: "October 2022 - October 2023",
    title: "Software Developer",
    company: "BotPro S.R.L",
    description:
      "Designed and developed chatbot automation solutions using Node.js. Built scalable backend services with Express and Prisma. Created intuitive, responsive UI components using React.js and TypeScript. Managed database operations with MySQL and MongoDB.",
  },
];
---

<ol class="relative mt-16">
  {
    EXPERIENCIE.map((experiencie) => (
      <li class="">
        <ExperienceItem {...experiencie} />
      </li>
    ))
  }
</ol>
