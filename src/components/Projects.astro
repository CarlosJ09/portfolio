---
import GitHub from "./icons/GitHub.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";

// Every number here must come verbatim from the vendor-vetting README or eval-results/.
const FEATURED = {
  title: "vendor-vetting",
  kicker: "LLM document pipeline · personal project",
  description:
    "Vets supplier document packets against the Dominican Republic's public procurement registry requirements. It classifies unlabeled files, extracts fields, validates them with deterministic rules, cross-checks the documents against each other, and produces a dossier where every finding links to the page and region that supports it.",
  principle: "The model extracts. The code validates.",
  principleDetail:
    "The model only reports what a document says. Expiry, check digits, and cross-document consistency are tested code, and a test fails the build if decision words appear in a prompt.",
  findings: [
    {
      stat: "0 / 16",
      text: "defective dossiers reported as <em>pass</em>. A false pass is the error that matters, so it's reported on its own.",
    },
    {
      stat: "1.00",
      text: "self-reported confidence on all 761 extracted fields, including the one wrong extraction. The model's confidence carried no information.",
    },
    {
      stat: "1 bug",
      text: "The only extraction error looked like a model failure. It was my own text-reconstruction code collapsing a column gap into a space.",
    },
    {
      stat: "8 GB",
      text: "Runs fully local: qwen2.5 7B on a laptop GPU, no API key. The demo is Next.js on Vercel + Supabase, with TLS that fails closed.",
    },
  ],
  github: "https://github.com/CarlosJ09/vendor-vetting",
  link: "https://vendor-vetting.vercel.app/",
};

const PROJECTS = [
  {
    title: "Dominicana de Seguros: public website",
    description:
      "The insurer's main public website, a production site I built from scratch. I chose the framework and stack (Next.js, Tailwind), set up the site's structure, wrote part of the content, and was responsible for performance and accessibility.",
    link: "https://dominicanadeseguros.com/site",
    image: "/projects/dominicana.png",
    imageAlt: "Dominicana de Seguros website home page",
  },
];

const OTHER = [
  {
    title: "Object Classification",
    description: "Image classification app with a FastAPI backend and a React frontend, run with Docker Compose.",
    github: "https://github.com/CarlosJ09/object_classification",
  },
];
---

<div class="flex flex-col gap-y-16">
  <article class="[&_em]:not-italic [&_em]:font-mono">
    <p class="text-sm font-mono text-emerald-600 dark:text-emerald-300">{FEATURED.kicker}</p>
    <h3 class="mt-1 text-2xl font-bold text-gray-800 dark:text-gray-100">{FEATURED.title}</h3>
    <p class="mt-3 text-gray-700 dark:text-gray-300 text-pretty">{FEATURED.description}</p>

    <blockquote class="mt-6 pl-4 border-l-2 border-emerald-500">
      <p class="text-lg font-semibold text-gray-800 dark:text-gray-100">{FEATURED.principle}</p>
      <p class="mt-1 text-gray-700 dark:text-gray-300">{FEATURED.principleDetail}</p>
    </blockquote>

    <dl class="grid gap-6 mt-8 sm:grid-cols-2">
      {
        FEATURED.findings.map(({ stat, text }) => (
          <div>
            <dt class="font-mono text-2xl text-gray-800 dark:text-gray-100">{stat}</dt>
            <dd class="mt-1 text-gray-700 dark:text-gray-400" set:html={text} />
          </div>
        ))
      }
    </dl>

    <footer class="flex items-end justify-start mt-8 gap-x-4">
      <LinkButton href={FEATURED.github}>
        <GitHub class="size-6" />
        Code
      </LinkButton>
      <LinkButton href={FEATURED.link}>
        <Link class="size-4" />
        Live demo
      </LinkButton>
    </footer>
  </article>

  {
    PROJECTS.map(({ image, imageAlt, title, description, link }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700">
            <img
              alt={imageAlt}
              class="object-cover object-top w-full h-56 min-h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
              loading="lazy"
              src={image}
            />
          </div>
        </div>

        <div class="w-full md:w-1/2">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">{title}</h3>
          <p class="mt-2 text-gray-700 dark:text-gray-400">{description}</p>
          <footer class="flex items-end justify-start mt-4 gap-x-4">
            <LinkButton href={link}>
              <Link class="size-4" />
              Visit site
            </LinkButton>
          </footer>
        </div>
      </article>
    ))
  }

  <div>
    <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Other</h3>
    <ul class="mt-2 space-y-1 text-gray-700 dark:text-gray-400">
      {
        OTHER.map(({ title, description, github }) => (
          <li>
            <a class="font-medium underline" href={github} target="_blank" rel="noopener">
              {title}
            </a>
            : {description}
          </li>
        ))
      }
    </ul>
  </div>
</div>
