---
import ExperienceItem from "./ExperienceItem.astro";

const EDUCATION = [
  {
    institution: "Instituto Tecnológico de Santo Domingo (INTEC)",
    degree: "Bachelor's Degree in Systems Engineering",
    date: "2021 – 2025",
  },
];
---

<ol class="space-y-14">
  {
    EDUCATION.map(({ institution, degree, date }) => (
      <li>
        <ExperienceItem company={institution} title={degree} date={date} />
      </li>
    ))
  }
</ol>
