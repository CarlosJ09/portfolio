---
import EducationItem from "./EducationItem.astro";

const EDUCATION = [
  {
    institution: "Instituto Tecnológico de Santo Domingo (INTEC)",
    degree: "Bachelor's Degree in Systems Engineering",
    date: "2021 – 2025",
  },
];
---

<ol class="relative mt-16">
  {
    EDUCATION.map((edu) => (
      <li>
        <EducationItem {...edu} />
      </li>
    ))
  }
</ol>
