---
interface Props {
  title: string;
  company: string;
  date: string;
  location?: string;
  summary?: string;
  /** Trusted, hand-written strings; may contain inline <code>/<em>. */
  highlights: string[];
}

const { title, company, date, location, summary, highlights } = Astro.props;
---

<div
  class="relative mx-12 pb-12 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-black/20 dark:before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10"
>
  <div class="relative pb-8 md:pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span class="text-emerald-400 -left-[42px] absolute rounded-full text-5xl">&bull;</span>
      <h3 class="text-xl font-bold text-emerald-400">{title}</h3>
      <h4 class="font-semibold text-xl text-gray-600 dark:text-white">{company}</h4>
      <time class="block p-0 m-0 text-sm text-gray-600/80 dark:text-white/80">{date}</time>
      {location && <p class="text-sm text-gray-600/80 dark:text-white/80">{location}</p>}
    </div>
  </div>
  <div class="relative flex flex-col gap-3 pb-4 text-gray-600 dark:text-gray-300 md:col-span-3">
    {summary && <p>{summary}</p>}
    <ul class="list-disc pl-5 space-y-2 [&_code]:font-mono [&_code]:text-sm">
      {highlights.map((item) => <li set:html={item} />)}
    </ul>
  </div>
</div>
