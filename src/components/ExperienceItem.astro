---
interface Props {
  title: string;
  company: string;
  date: string;
  /** "City, Country · Work mode"; each part renders on its own line. */
  location?: string;
  summary?: string;
  /** Trusted, hand-written strings; may contain inline <code>/<em>/<a>. */
  highlights?: string[];
}

const { title, company, date, location, summary, highlights = [] } = Astro.props;
---

<article class="grid gap-x-8 gap-y-3 md:grid-cols-[10rem_1fr]">
  <div class="font-mono text-xs leading-relaxed text-muted md:pt-1.5">
    <p class="text-ink">{date}</p>
    {location?.split(" · ").map((part) => <p>{part}</p>)}
  </div>
  <div>
    <h3 class="text-xl font-semibold tracking-tight">{company}</h3>
    <p class="italic text-muted">{title}</p>
    {summary && <p class="mt-4 text-pretty">{summary}</p>}
    {
      highlights.length > 0 && (
        <ul class="mt-4 space-y-2.5 text-pretty">
          {highlights.map((item) => (
            <li class="relative pl-5 before:absolute before:left-0 before:top-0 before:text-rule before:content-['—']" set:html={item} />
          ))}
        </ul>
      )
    }
  </div>
</article>
