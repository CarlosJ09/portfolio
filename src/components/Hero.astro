---
import { getYearsOfExperience, LINKS } from "@/consts";
---

<div class="max-w-2xl">
  <div class="flex items-center gap-4 mb-10">
    <img
      class="size-14 rounded-full object-cover ring-1 ring-rule"
      src="/me.JPG"
      alt="Carlos Jiménez"
      width="56"
      height="56"
    />
    <a
      href={LINKS.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-muted hover:text-accent"
    >
      <span aria-hidden="true" class="size-1.5 rounded-full bg-accent"></span>
      Open to work
    </a>
  </div>

  <h1 class="text-5xl sm:text-6xl font-semibold tracking-tight leading-[1.05]">Carlos Jiménez</h1>

  <p class="mt-5 text-2xl sm:text-[1.75rem] leading-snug text-muted">
    Full-stack engineer who builds AI features with LLMs.
  </p>

  <p class="mt-8 text-lg text-pretty">
    <span id="years-exp">{getYearsOfExperience()}</span>+ years shipping TypeScript across the
    stack: Vue 3 and React, NestJS, AWS. I put LLMs where they're good at reading, and I write the
    code that decides. When the system isn't sure, I'd rather it say <em>needs review</em> than
    guess.
  </p>

  <p class="mt-6 font-mono text-xs text-muted">
    Currently at Thryv · Based in Santo Domingo, Dominican Republic
  </p>

  <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm">
    <li><a class="link" href={LINKS.email}>Email</a></li>
    <li>
      <a class="link" href={LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
    </li>
    <li>
      <a class="link" href={LINKS.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </li>
  </ul>
</div>

<script>
  import { getYearsOfExperience } from "@/consts";

  document.addEventListener("astro:page-load", () => {
    const yearsSpan = document.getElementById("years-exp");
    if (yearsSpan) {
      yearsSpan.textContent = getYearsOfExperience().toString();
    }
  });
</script>
