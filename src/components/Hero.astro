---
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
import GitHub from "./icons/GitHub.astro";
import { getYearsOfExperience } from "@/consts";

const personalImageAlt = "Carlos Jiménez";
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img class="rounded-full shadow-lg size-16" src="/me.JPG" alt={personalImageAlt} />
    <a
      href="https://www.linkedin.com/in/carlos-jimenezz"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Open to work</Badge>
    </a>
  </div>
  <h1
    class="md:w-screen text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hey, I'm <span id="typing-text" class="relative"></span>
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-emerald-200 [&>strong]:text-emerald-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    +<span id="years-exp">{getYearsOfExperience()}</span> years of experience. <strong>Systems Engineer and Software Developer</strong> from Santo Domingo,
    DR 🇩🇴. Specialized in Web Development.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:carlos.ml.jimenezz@gmail.com">
      <MailIcon class="size-4" />
      Get in touch
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/carlos-jimenezz/">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/CarlosJ09">
      <GitHub class="size-4" />
      Github
    </SocialPill>
  </nav>
</div>

<style>
  #typing-text::after {
    content: "|";
    position: absolute;
    right: -8px;
    width: 8px;
    animation: blink 0.75s step-end infinite;
  }

  @keyframes blink {
    from,
    to {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  import { getYearsOfExperience } from "@/consts";

  const phrases = ["Carlos Jiménez", "a Software Developer", "a Full Stack Engineer"];

  const typingText = document.getElementById("typing-text");
  let phraseIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  let typingDelay = 100;
  const deletingDelay = 50;
  const pauseDelay = 4000;

  function typeText() {
    const currentPhrase = phrases[phraseIndex];

    if (isDeleting) {
      if (typingText) {
        typingText.textContent = currentPhrase.substring(0, charIndex - 1);
        charIndex--;
      }

      typingDelay = deletingDelay;
    } else {
      if (typingText) {
        typingText.textContent = currentPhrase.substring(0, charIndex + 1);
        charIndex++;
      }

      typingDelay = 100;
    }

    if (!isDeleting && charIndex === currentPhrase.length) {
      typingDelay = pauseDelay;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      phraseIndex = (phraseIndex + 1) % phrases.length;
    }

    setTimeout(typeText, typingDelay);
  }

  document.addEventListener("astro:page-load", () => {
    setTimeout(typeText, typingDelay);
    const yearsSpan = document.getElementById("years-exp");
    if (yearsSpan) {
      yearsSpan.textContent = getYearsOfExperience().toString();
    }
  });
</script>
