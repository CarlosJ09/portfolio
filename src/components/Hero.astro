---
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
import GitHub from "./icons/GitHub.astro";
import { getYearsOfExperience } from "@/consts";
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img class="rounded-full shadow-lg size-16" src="/me.JPG" alt="Carlos Jiménez" />
    <a
      href="https://www.linkedin.com/in/carlos-jimenezz"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Open to work</Badge>
    </a>
  </div>

  <h1 class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white">
    Carlos Jiménez
  </h1>

  <p class="mt-4 text-2xl font-semibold text-gray-800 dark:text-gray-100">
    Full-stack engineer who builds AI features with LLMs.
  </p>

  <p class="mt-6 text-lg text-gray-700 dark:text-gray-300 text-pretty">
    <span id="years-exp">{getYearsOfExperience()}</span>+ years shipping TypeScript across the
    stack: Vue 3 and React, NestJS, AWS. I put LLMs where they're good at reading, and I write
    the code that decides. When the system isn't sure, I'd rather it say <em>needs review</em> than
    guess.
  </p>

  <p class="mt-4 text-gray-600 dark:text-gray-400">
    Currently at Thryv. Based in Santo Domingo, Dominican Republic.
  </p>

  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:carlos.ml.jimenezz@gmail.com">
      <MailIcon class="size-4" />
      Get in touch
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/carlos-jimenezz/">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/CarlosJ09">
      <GitHub class="size-4" />
      GitHub
    </SocialPill>
  </nav>
</div>

<script>
  import { getYearsOfExperience } from "@/consts";

  document.addEventListener("astro:page-load", () => {
    const yearsSpan = document.getElementById("years-exp");
    if (yearsSpan) {
      yearsSpan.textContent = getYearsOfExperience().toString();
    }
  });
</script>
