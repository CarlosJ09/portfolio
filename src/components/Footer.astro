---
import { LINKS } from "@/consts";

const currentYear = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-page px-5 sm:px-8 mt-24 mb-12">
  <div
    class="border-t border-rule pt-6 flex flex-wrap justify-between gap-x-8 gap-y-3 font-mono text-xs text-muted"
  >
    <span>© <span id="footer-year">{currentYear}</span> Carlos Jiménez</span>
    <ul class="flex flex-wrap gap-x-4">
      <li><a class="hover:text-accent" href={LINKS.email}>Email</a></li>
      <li>
        <a class="hover:text-accent" href={LINKS.linkedin} target="_blank" rel="noopener noreferrer"
          >LinkedIn ↗</a
        >
      </li>
      <li>
        <a class="hover:text-accent" href={LINKS.github} target="_blank" rel="noopener noreferrer"
          >GitHub ↗</a
        >
      </li>
    </ul>
  </div>
</footer>

<script>
  document.addEventListener("astro:page-load", () => {
    const el = document.getElementById("footer-year");
    if (el) el.textContent = new Date().getFullYear().toString();
  });
</script>
