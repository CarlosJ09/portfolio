    font-style: italic;
  }
  .quote {
    margin: 1.5rem 0;
    border-left: 2px solid rgb(var(--rule));
    padding-left: 1.5rem;
    color: rgb(var(--muted));
  }
  .quote p:first-child {
    margin-top: 0;
  }

  .pipeline {
    margin: 2rem 0;
    border-left: 1px solid rgb(var(--rule));
  }
  .pipeline li {
    position: relative;
    display: grid;
    gap: 0.25rem 1.5rem;
    padding: 0.6rem 0 0.6rem 1.5rem;
  }
